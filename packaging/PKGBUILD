# libfprint with the crfpmoc driver for ChromeOS fingerprint MCUs (/dev/cros_fp).
#
# Builds a pinned commit of our libfprint branch: upstream master, plus the
# driver from upstream merge request !512, plus fixes. Modeled on Arch's
# official libfprint PKGBUILD. It is not related to the AUR package
# libfprint-crfpmoc-git and shares nothing with it.
#
# To build from a local clone instead of GitHub (e.g. offline):
#   LIBFPRINT_REPO=file:///path/to/libfprint makepkg -f
pkgname=libfprint-crfpmoc-local
pkgver=1.94.100.r59.ge0cebe40
pkgrel=1
pkgdesc="Library for fingerprint readers, with the crfpmoc ChromeOS fingerprint MCU driver"
url="https://fprint.freedesktop.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(libgcc glib2 glibc libgudev libgusb openssl pixman)
makedepends=(git glib2-devel meson systemd)
# libfprint-2.so=2-64 is the soname dependency of the official fprintd package;
# check with: pacman -Si fprintd | grep Depends
provides=("libfprint=1.94.100" libfprint-git "libfprint-2.so=2-64")
conflicts=(libfprint libfprint-git)
groups=(fprint)
options=(!debug)

_repo=${LIBFPRINT_REPO:-https://github.com/lugnut42/libfprint.git}
_commit=e0cebe40636941b7684666d63e1068cec527f105
source=("libfprint::git+$_repo#commit=$_commit")
sha256sums=(SKIP)

build() {
  # Same driver set as the official package; introspection and docs are left
  # out because fprintd does not need them and they pull in extra build deps.
  arch-meson libfprint build \
    -D drivers=all \
    -D installed-tests=false \
    -D introspection=false \
    -D doc=false
  meson compile -C build
}

check() {
  # Unit tests only; the driver replay tests need introspection and umockdev.
  meson test -C build --suite unit-tests --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
}
